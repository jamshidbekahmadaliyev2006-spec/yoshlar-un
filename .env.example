# Server konfiguratsiyasi
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL ma'lumotlar bazasi URL manzili
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yunusobod_birga?schema=public

# JWT xavfsizlik kaliti va muddatlari
JWT_SECRET=yunusobod_birga_super_secret_jwt_key_2026_xyz
JWT_EXPIRES_IN=7d

# Dastlabki admin foydalanuvchi ma'lumotlari
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin
ADMIN_PHONE=+998901234567

# SMS Gateway (Eskiz / PlayMobile / Infobip) - ixtiyoriy
SMS_GATEWAY_URL=https://notify.eskiz.uz/api
SMS_GATEWAY_TOKEN=your_sms_gateway_token_here
OTP_EXPIRY_MINUTES=5

# Fayl yuklash (Uploads)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

